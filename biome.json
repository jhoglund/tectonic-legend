{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "extends": ["@hoglund/config/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["!**/prototypes", "!**/ios/App/App/public"]
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
